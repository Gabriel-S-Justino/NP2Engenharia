# =====================================================================
# Acervo IA — variáveis de ambiente (copie para .env e ajuste)
# NUNCA coloque credenciais reais neste arquivo de exemplo.
# Inventário completo: docs/VARIAVEIS_AMBIENTE.md
# =====================================================================

# --- Backend (servidor) ---
APP_ENV=development                 # development | test | production
API_HOST=127.0.0.1                  # use 0.0.0.0 apenas em contêiner/rede controlada
API_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
LOG_LEVEL=INFO

DOCUMENTS_DIR=Documentos            # documentos originais da equipe (somente leitura para o sistema)
DATA_DIR=data                       # banco SQLite, índice vetorial, uploads e relatórios

VECTOR_STORE=faiss                  # faiss | numpy
EMBEDDING_PROVIDER=fastembed        # fastembed (semântico, local) | hashing (lexical, só testes/demo offline)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_CACHE_DIR=data/models   # cache do modelo baixado (persistente em produção)

LLM_PROVIDER=demo                   # demo (extrativo, sem LLM) | anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=                        # somente no servidor; nunca no frontend
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
LLM_EFFORT=low

CHUNK_SIZE=800                      # caracteres
CHUNK_OVERLAP=120                   # caracteres
TOP_K=5
# SIMILARITY_THRESHOLD=             # vazio = padrão por provedor (hashing 0.15; fastembed 0.35 — recalibrar!)
MIN_TERM_COVERAGE=0.5
MAX_UPLOAD_SIZE_MB=20
MAX_QUESTION_CHARS=1000

ADMIN_TOKEN=                        # obrigatório em produção para upload/indexação/exclusão
RATE_LIMIT_PER_MINUTE=30
AUTO_INGEST_ON_STARTUP=false
HISTORY_RETENTION_DAYS=30
OCR_ENABLED=false

# --- Frontend (público: entra no bundle; NUNCA coloque segredos aqui) ---
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
